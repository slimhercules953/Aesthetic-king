generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique

  username    String?
  displayName String?
  avatarHash  String?

  // The Stripe Customer we created for this account. Reused for every
  // checkout so one account is one customer: subscriptions, invoices and
  // payment methods then group under a single id instead of piling up a
  // new customer per purchase. Set by the checkout route, never by the
  // browser.
  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every studio session token stamped with a lower value is rejected.
  // Logout increments it; null means "never revoked".
  sessionEpoch BigInt?

  savedAesthetics SavedAesthetic[]
  profiles        Profile[]
  savedPalettes   SavedPalette[]
  collections     Collection[]
  favorites       FavoriteAsset[]
  history         GenerationHistory[]
  entitlements    Entitlement[]
  patchNotices    PatchNotification[]

  featureUsage     FeatureUsage[]
  crownTransactions CrownTransaction[]
  crownUnlocks     CrownUnlock[]

  shares        SharedPost[]
  sharedLikes   SharedPostLike[]
  sharedComment SharedPostComment[]
  sharedViews   SharedPostView[]

  /// Work other users made by remixing this account's published posts.
  remixedAesthetics SavedAesthetic[] @relation("AestheticRemixAuthor")
  remixedPalettes   SavedPalette[]   @relation("PaletteRemixAuthor")

  notifications Notification[]

  discordOAuth DiscordOAuthCredential?
}

/// Something the user asked to be told about. Rows are written by the
/// event sources (feed likes, entitlement grants, profile edits, votes)
/// and read by the bell in the topbar.
///
/// `dedupeKey` is what stops a re-run of the same event from producing a
/// second row — a webhook delivered twice, or a profile saved twice in a
/// minute. It is nullable because some notices are genuinely one-off and
/// have nothing to dedupe on.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title String
  body  String?

  /// Where the bell sends the user when they open the notice.
  href String?

  /// Optional icon hint so the UI can pick a glyph without switching on
  /// `type` in three places.
  icon String?

  readAt DateTime?

  /// Set once a recurring notice has been emitted, e.g. the seven-day
  /// Premium expiry warning. Lets a periodic sweep be run repeatedly
  /// without spamming.
  dedupeKey String? @unique

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

enum NotificationType {
  /// Someone liked a profile or aesthetic the user shared.
  LIKE

  /// Premium was granted.
  PREMIUM_GRANTED

  /// Premium was revoked or refunded.
  PREMIUM_REVOKED

  /// Premium ends within the warning window.
  PREMIUM_EXPIRING

  /// A new changelog / patch note was published.
  BOT_UPDATE

  /// Thank-you for a top.gg vote.
  VOTE

  /// A server the user manages hit a usage limit or lost the bot.
  SERVER

  /// Someone copied a post the user published into their own library.
  REMIX
}

model DiscordOAuthCredential {
  id     String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String @db.Text
  refreshToken String @db.Text

  tokenType String
  scope     String

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model SavedAesthetic {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId String? @unique

  name String

  aestheticId String
  moodId      String?
  colorFilter String?

  profileSetId String?

  usernameIdea String?
  bio          String?
  status       String?

  symbols String[]
  palette String[]

  /**
   * Set when this aesthetic was made by remixing someone's published
   * post. `remixedFromUserId` is kept even though the post row already
   * knows its author, because the source post can be unshared and the
   * credit must survive that.
   *
   * Both are nullable and both are cleared (never cascaded) if the
   * original creator deletes their account — a remix is the remixer's
   * work, and deleting somebody else's account must not delete it.
   */
  remixedFromPostId String?
  remixedFromUserId String?

  remixedFromPost SharedPost? @relation("AestheticRemixSource", fields: [remixedFromPostId], references: [id], onDelete: SetNull)
  remixedFromUser User?       @relation("AestheticRemixAuthor", fields: [remixedFromUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([aestheticId])
  @@index([remixedFromPostId])
  @@index([remixedFromUserId])
}

/**
 * A profile the user is building in the Studio Profile Builder.
 *
 * Deliberately separate from `SavedAesthetic`. A saved aesthetic is a
 * snapshot of a generation and cannot exist without an `aestheticId`;
 * a profile is something the user assembles by hand and may borrow
 * from several generations. Merging the two would force a hand-built
 * profile to invent a fake `aestheticId` just to satisfy the column.
 *
 * Exactly one profile per user has `isActive` true: the one the
 * Builder opens with and the one "Apply" refers to.
 */
model Profile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(false)

  profileSetId String?

  username      String?
  discriminator String?
  pronouns      String?

  bio    String?
  status String?

  symbols String[]
  palette String[]

  /**
   * Banner/accent color when the profile uses no profile set, as a
   * `#rrggbb` string. Null means "fall back to the palette".
   */
  accentColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

model SavedPalette {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String?

  aestheticId String?
  moodId      String?

  colors String[]

  /// Provenance when this palette was made by remixing a published post.
  /// See `SavedAesthetic.remixedFromPostId` for why both columns exist.
  remixedFromPostId String?
  remixedFromUserId String?

  remixedFromPost SharedPost? @relation("PaletteRemixSource", fields: [remixedFromPostId], references: [id], onDelete: SetNull)
  remixedFromUser User?       @relation("PaletteRemixAuthor", fields: [remixedFromUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([remixedFromPostId])
  @@index([remixedFromUserId])
}

model FavoriteAsset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetType AssetType
  assetKey  String
  setId     String?

  createdAt DateTime @default(now())

  @@unique([userId, assetKey])
  @@index([userId])
}

model Collection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  itemType CollectionItemType
  itemId   String

  createdAt DateTime @default(now())

  @@unique([collectionId, itemType, itemId])
  @@index([collectionId])
}

model Guild {
  id        String @id @default(cuid())
  discordId String @unique

  name     String?
  iconHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        GuildSettings?
  commandSettings GuildCommandSetting[]
  aestheticPacks  AestheticPack[]
  accessRules     GuildAccessRule[]
  cosmeticRoles   GuildCosmeticRole[]
}

model GuildSettings {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  defaultAestheticId String?
  defaultMoodId      String?

  generationChannelId String?

  defaultPackId String?
  defaultPack   AestheticPack? @relation("DefaultAestheticPack", fields: [defaultPackId], references: [id], onDelete: SetNull)

  /// Presentation choices for this server, edited in Server Studio >
  /// Appearance. Every field is nullable/optional so a server that has
  /// never opened the tab keeps the bot's built-in behavior instead of
  /// inheriting an arbitrary default.
  embedColor         String?
  footerText         String?
  showPackBadge      Boolean   @default(true)
  showGeneratedImages Boolean  @default(true)
  showRerollButtons  Boolean   @default(true)

  /// Member colour roles (`/color`). Off until the owner turns it on, so a
  /// bot that gains Manage Roles on re-invite does not start handing out
  /// colours nobody asked for.
  colorRolesEnabled Boolean @default(false)
  /// `FREE` — members type any hex. `PALETTE` — only the colours the owner
  /// has marked self-assignable. PALETTE is the option for servers that want
  /// a house look; FREE is for casual ones.
  colorRoleMode     String  @default("FREE")

  /// Setup checklist progress. Kept separate from the values above on
  /// purpose: a checklist records that an owner *did* configure
  /// something, so clearing the value later must not re-open the step.
  /// Without these the progress bar silently un-checks itself.
  setupGenerationDone Boolean @default(false)
  setupPackDone       Boolean @default(false)
  setupAestheticDone  Boolean @default(false)
  setupMoodDone       Boolean @default(false)
  setupAccessDone     Boolean @default(false)
  setupAppearanceDone Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultPackId])
}

model GuildCommandSetting {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  commandName String
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, commandName])
  @@index([guildId])
}

model AestheticPack {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  name        String
  description String?

  aestheticId String?
  moodId      String?

  colors  String[]
  symbols String[]

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForSettings GuildSettings[] @relation("DefaultAestheticPack")

  @@unique([guildId, name])
  @@index([guildId])
  @@index([enabled])
}

/// Who may use the bot inside a server, edited in Server Studio > Access.
///
/// Kept separate from GuildSettings because the cardinality differs: a
/// server has exactly one settings row but an unbounded set of rules.
/// `kind` is ROLE or CHANNEL; `effect` is ALLOW or DENY. An empty rule set
/// means the bot is open to the whole server, so a server that never
/// touches this tab is never accidentally locked out.
model GuildAccessRule {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  kind   String
  effect String  @default("ALLOW")
  targetId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, kind, targetId])
  @@index([guildId])
}

/// Cosmetic roles created by the role maker in Server Studio > Appearance, or
/// on the fly by a member using `/color`.
///
/// The role itself lives in Discord; this row is the receipt. It exists so
/// the dashboard can tell an owner "these are the roles this tool made"
/// instead of dumping the whole role list on them, so a renamed or deleted
/// role is still traceable back to whoever created it, and — critically — so
/// that `/color` only ever hands out roles it knows it made. Without that
/// boundary a colour picker would be a privilege-escalation tool.
///
/// `discordRoleId` is unique because a role can only have been created once.
model GuildCosmeticRole {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  discordRoleId String
  name          String
  color         String
  createdBy     String?

  /// How the role came to exist: made by an owner in the dashboard, or made
  /// for a member who typed a hex into `/color`.
  source String @default("STUDIO")

  /// Offered by `/color` in PALETTE mode. Only an owner sets this, which is
  /// what makes a curated palette curated — a colour a member invented in
  /// free mode is not thereby approved for everyone else.
  selfAssignable Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([guildId, discordRoleId])
  @@index([guildId])
}

/// Append-only usage log behind Server Studio > Analytics.
///
/// Deliberately denormalized: `guildId` and `discordUserId` are raw
/// Discord snowflakes with no foreign keys, because this is written on the
/// hot path of every interaction and an insert must never fail because of
/// referential integrity or an unsynced row. Analytics are therefore
/// best-effort counts, not an authoritative ledger.
model GuildUsageEvent {
  id String @id @default(cuid())

  guildId       String
  discordUserId String

  commandName String
  component   String   @default("command")

  aestheticId String?
  moodId      String?
  packId      String?
  premium     Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([guildId, commandName])
}

model SharedPost {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemType SharedItemType
  itemId   String

  caption String?
  tags    String[]

  likeCount    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    SharedPostLike[]
  comments SharedPostComment[]
  views    SharedPostView[]

  /// Saved items other users made by remixing this post.
  remixedAesthetics SavedAesthetic[] @relation("AestheticRemixSource")
  remixedPalettes   SavedPalette[]   @relation("PaletteRemixSource")

  @@unique([userId, itemType, itemId])
  @@index([createdAt])
  @@index([likeCount])
  @@index([itemType, itemId])
  @@index([itemType, createdAt])
  @@index([itemType, likeCount, createdAt])
}

model SharedPostLike {
  userId String
  postId String

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SharedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

/// One row per (post, viewer) rather than one row per impression.
///
/// Creator analytics wants two different numbers — how many *people* saw a
/// post and how many *times* it was seen — and only the first is honest
/// reach. Counting raw impressions would let one tab refreshing on a feed
/// produce a four-figure view count, so the row is upserted: `views` grows,
/// `lastViewAt` moves, and the row's existence is the unique-audience
/// count.
///
/// The author never gets a row. A creator scrolling their own published work
/// would otherwise be their own biggest audience, which makes every stat on
/// the page meaningless.
model SharedPostView {
  userId String
  postId String

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SharedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  views       Int      @default(1)
  firstViewAt DateTime @default(now())
  lastViewAt  DateTime @default(now())

  @@id([userId, postId])
  @@index([postId, lastViewAt])
  @@index([userId])
}

model SharedPostComment {
  id     String @id @default(cuid())
  postId String
  post   SharedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId])
}

model GenerationHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type GenerationType

  aestheticId String?
  moodId      String?

  data Json

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PatchNote {
  id String @id @default(cuid())

  version String @unique
  title   String
  body    String

  publishedAt DateTime @default(now())

  notifications PatchNotification[]
}

model PatchNotification {
  userId  String
  patchId String

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patch PatchNote @relation(fields: [patchId], references: [id], onDelete: Cascade)

  notifiedAt DateTime @default(now())

  @@id([userId, patchId])
}

/// A grant of access. Rows are never deleted, only deactivated, so
/// what a user once paid for stays auditable.
model Entitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type EntitlementType

  source String?
  active Boolean @default(true)

  /// The store SKU this grant came from, e.g. a Discord Application
  /// Store SKU ID. Null for manual, staff and dev grants.
  skuId String?

  /// The provider's own entitlement/purchase ID. Kept so a replayed
  /// webhook is recognized as a duplicate and so a refund can revoke
  /// the exact grant it applies to rather than "any Premium".
  externalEntitlementId String?

  startsAt DateTime @default(now())
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])

  /// A webhook may be delivered more than once. This makes the second
  /// delivery findable. Partial (non-null only) so many manual grants
  /// can coexist.
  @@unique([externalEntitlementId], map: "Entitlement_externalEntitlementId_key")
}

/// One row per (user, feature, reset window). Consumption is
/// accumulated here rather than recomputed from feature tables so
/// that limits stay cheap to check and survive source-data churn.
model FeatureUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature  String
  periodKey String

  used Int     @default(0)
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature, periodKey])
  @@index([userId, feature])
}

/// Append-only Crown ledger. The balance is the SUM of amounts, so
/// there is no single mutable column to drift out of sync.
model CrownTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   CrownTransactionType
  amount Int

  reason String
  source String?

  /// Client-generated key that makes a retried spend a no-op.
  idempotencyKey String?

  createdAt DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

enum CrownTransactionType {
  EARN
  SPEND
  ADJUSTMENT
  REFUND
}

/// How a Crown unlock relaxes a limit.
enum CrownUnlockKind {
  /// Extra allowance on a metered feature, scoped to one reset window.
  BOOST

  /// Access to a gated feature until `expiresAt`.
  TIMED
}

/// A feature paid for with Crowns instead of a subscription.
///
/// Metered features get a `BOOST`: `allowance` extra uses inside
/// `periodKey`, which expires on its own when the window rolls over.
/// Gated features get a `TIMED` unlock that runs until `expiresAt`.
///
/// `periodKey` is always set — timed unlocks use the literal
/// `TIMED` — so the unique index keeps exactly one row per
/// (user, feature, window) and a repeat purchase updates that row
/// instead of buying a second one. That is what stops a
/// double-clicked button from spending Crowns twice.
model CrownUnlock {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature String
  kind    CrownUnlockKind

  /// Window a boost applies to, or `TIMED` for gated unlocks.
  periodKey String

  /// Extra uses a boost grants. Null for TIMED.
  allowance Int?

  /// When a timed unlock stops applying. Null for BOOST.
  expiresAt DateTime?

  /// The CrownTransaction that paid for this unlock.
  transactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature, periodKey], map: "CrownUnlock_userId_feature_periodKey_key")
  @@index([userId, feature])
  @@index([userId, expiresAt])
}

enum AssetType {
  PFP
  BANNER
}

enum CollectionItemType {
  AESTHETIC
  PALETTE
  ASSET
}

enum GenerationType {
  AESTHETIC
  BIO
  STATUS
  USERNAME
  PALETTE
}

/// What a feed post renders.
///
/// `AESTHETIC` is a saved generation, `PALETTE` a saved palette, and `ASSET`
/// a catalog profile set. `PROFILE` is a Profile Builder composition — the
/// thing a user actually assembles and applies, which until now had no way
/// out of their own account. `PACK` is a server's Aesthetic Pack, published
/// by someone entitled to speak for that server.
///
/// Adding a member here is not enough to make a type publishable: the item
/// has to be owned (or authorised), hydrated into card media, and matched by
/// feed search. See `assertPublishableItem()` in `lib/sharedFeed.ts`.
enum SharedItemType {
  AESTHETIC
  PALETTE
  ASSET
  PROFILE
  PACK
}

enum EntitlementType {
  PREMIUM
  SERVER_PREMIUM
}

/// One row per payment-provider webhook the app has actually acted on.
///
/// Providers redeliver aggressively: any non-2xx answer is retried, and
/// Stripe also sends the same event more than once under load. The
/// unique index on (provider, externalEventId) turns a replay into an
/// insert conflict that the handler skips, so "claim the event, then do
/// the work" is safe without a distributed lock.
///
/// `payload` keeps the decoded event so a disputed grant can be
/// reconstructed months later without the provider's event history,
/// which is pruned.
model PaymentEventRecord {
  id String @id @default(cuid())

  /// Which provider sent it, e.g. "stripe". Namespaced because two
  /// providers may hand out the same-shaped id independently.
  provider String

  /// The provider's own event id.
  externalEventId String

  /// One of the PaymentEventKind values the app understands.
  kind String

  /// Account the event was attributed to, when it named one.
  discordId String?

  payload Json

  processedAt DateTime @default(now())

  @@unique([provider, externalEventId], map: "PaymentEventRecord_provider_externalEventId_key")
  @@index([discordId, processedAt])
}
