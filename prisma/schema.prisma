generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique

  username    String?
  displayName String?
  avatarHash  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedAesthetics SavedAesthetic[]
  savedPalettes   SavedPalette[]
  collections     Collection[]
  favorites       FavoriteAsset[]
  history         GenerationHistory[]
  entitlements    Entitlement[]
  patchNotices    PatchNotification[]

  featureUsage     FeatureUsage[]
  crownTransactions CrownTransaction[]

  shares        SharedPost[]
  sharedLikes   SharedPostLike[]
  sharedComment SharedPostComment[]

  discordOAuth DiscordOAuthCredential?
}

model DiscordOAuthCredential {
  id     String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String @db.Text
  refreshToken String @db.Text

  tokenType String
  scope     String

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model SavedAesthetic {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId String? @unique

  name String

  aestheticId String
  moodId      String?
  colorFilter String?

  profileSetId String?

  usernameIdea String?
  bio          String?
  status       String?

  symbols String[]
  palette String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([aestheticId])
}

model SavedPalette {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String?

  aestheticId String?
  moodId      String?

  colors String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model FavoriteAsset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetType AssetType
  assetKey  String
  setId     String?

  createdAt DateTime @default(now())

  @@unique([userId, assetKey])
  @@index([userId])
}

model Collection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  itemType CollectionItemType
  itemId   String

  createdAt DateTime @default(now())

  @@unique([collectionId, itemType, itemId])
  @@index([collectionId])
}

model Guild {
  id        String @id @default(cuid())
  discordId String @unique

  name     String?
  iconHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        GuildSettings?
  commandSettings GuildCommandSetting[]
  aestheticPacks  AestheticPack[]
}

model GuildSettings {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  defaultAestheticId String?
  defaultMoodId      String?

  generationChannelId String?

  defaultPackId String?
  defaultPack   AestheticPack? @relation("DefaultAestheticPack", fields: [defaultPackId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultPackId])
}

model GuildCommandSetting {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  commandName String
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, commandName])
  @@index([guildId])
}

model AestheticPack {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  name        String
  description String?

  aestheticId String?
  moodId      String?

  colors  String[]
  symbols String[]

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForSettings GuildSettings[] @relation("DefaultAestheticPack")

  @@unique([guildId, name])
  @@index([guildId])
  @@index([enabled])
}

model SharedPost {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemType SharedItemType
  itemId   String

  caption String?
  tags    String[]

  likeCount    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    SharedPostLike[]
  comments SharedPostComment[]

  @@unique([userId, itemType, itemId])
  @@index([createdAt])
  @@index([likeCount])
  @@index([itemType, itemId])
}

model SharedPostLike {
  userId String
  postId String

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SharedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

model SharedPostComment {
  id     String @id @default(cuid())
  postId String
  post   SharedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId])
}

model GenerationHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type GenerationType

  aestheticId String?
  moodId      String?

  data Json

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PatchNote {
  id String @id @default(cuid())

  version String @unique
  title   String
  body    String

  publishedAt DateTime @default(now())

  notifications PatchNotification[]
}

model PatchNotification {
  userId  String
  patchId String

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patch PatchNote @relation(fields: [patchId], references: [id], onDelete: Cascade)

  notifiedAt DateTime @default(now())

  @@id([userId, patchId])
}

/// A grant of access. Rows are never deleted, only deactivated, so
/// what a user once paid for stays auditable.
model Entitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type EntitlementType

  source String?
  active Boolean @default(true)

  /// The store SKU this grant came from, e.g. a Discord Application
  /// Store SKU ID. Null for manual, staff and dev grants.
  skuId String?

  /// The provider's own entitlement/purchase ID. Kept so a replayed
  /// webhook is recognised as a duplicate and so a refund can revoke
  /// the exact grant it applies to rather than "any Premium".
  externalEntitlementId String?

  startsAt DateTime @default(now())
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])

  /// A webhook may be delivered more than once. This makes the second
  /// delivery findable. Partial (non-null only) so many manual grants
  /// can coexist.
  @@unique([externalEntitlementId], map: "Entitlement_externalEntitlementId_key")
}

/// One row per (user, feature, reset window). Consumption is
/// accumulated here rather than recomputed from feature tables so
/// that limits stay cheap to check and survive source-data churn.
model FeatureUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature  String
  periodKey String

  used Int     @default(0)
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature, periodKey])
  @@index([userId, feature])
}

/// Append-only Crown ledger. The balance is the SUM of amounts, so
/// there is no single mutable column to drift out of sync.
model CrownTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   CrownTransactionType
  amount Int

  reason String
  source String?

  /// Client-generated key that makes a retried spend a no-op.
  idempotencyKey String?

  createdAt DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

enum CrownTransactionType {
  EARN
  SPEND
  ADJUSTMENT
  REFUND
}

enum AssetType {
  PFP
  BANNER
}

enum CollectionItemType {
  AESTHETIC
  PALETTE
  ASSET
}

enum GenerationType {
  AESTHETIC
  BIO
  STATUS
  USERNAME
  PALETTE
}

enum SharedItemType {
  AESTHETIC
  PALETTE
  ASSET
}

enum EntitlementType {
  PREMIUM
  SERVER_PREMIUM
}
