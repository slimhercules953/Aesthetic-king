{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",

  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  "images": {
    "binding": "IMAGES"
  },

  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "cache": {
    "enabled": false
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8704d924be2c44c5a309057f686c82aa"
    }
  ],

  "vpc_services": [
    {
      "binding": "OLLAMA",
      "service_id": "01a0e302-8504-7063-919d-2164846ca285",
      "remote": true
    }
  ],

  "services": [
    {
      "binding": "RESPONSE_STORE",
      "service": "studio-response-store",
      "entrypoint": "ResponseStoreService"
    }
  ]
}