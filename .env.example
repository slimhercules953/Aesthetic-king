# Discord
TOKEN=
CLIENT_ID=
DEV_GUILD_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aesthetic-king
# Required by the /profile and /theme slash commands (public bucket URL,
# e.g. https://pub-<hash>.r2.dev or a custom domain)
R2_PUBLIC_URL=
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# AI
OLLAMA_URL=http://YOUR_OLLAMA_HOST:11434
OLLAMA_MODEL=your-model-name

# Studio
# Where the web app lives. Used only to link users to the page that
# unlocks a premium feature, so it is optional: without it the bot
# names the path instead of linking to it.
STUDIO_URL=http://localhost:3000

# Application
NODE_ENV=development