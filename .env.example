# Discord
TOKEN=
CLIENT_ID=
DEV_GUILD_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aesthetic-king
# Required by the /profile and /theme slash commands (public bucket URL,
# e.g. https://pub-<hash>.r2.dev or a custom domain)
R2_PUBLIC_URL=
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# AI
OLLAMA_URL=http://YOUR_OLLAMA_HOST:11434
OLLAMA_MODEL=your-model-name

# Studio
# Where the web app lives. Used only to link users to the page that
# unlocks a premium feature, so it is optional: without it the bot
# names the path instead of linking to it.
#
# Set this to the PUBLIC domain. A localhost or LAN address (e.g.
# http://10.40.10.47:3000) is ignored with a warning, because the link
# ends up in embeds other people read and a machine address is useless
# to them. Set STUDIO_URL_ALLOW_PRIVATE=true to override that while
# testing against a local dev server.
STUDIO_URL=https://your-studio-domain.example

# Studio: Top.gg vote webhook
# The authorization token you enter on Top.gg's webhook settings page.
# The Studio reads this from its own .env.local; it is listed here so the
# variable is not forgotten when a deployment is assembled. Without it the
# /api/webhooks/topgg route answers 404, votes pay nothing, and the Earn
# page hides the Top.gg source. Unset until the Studio has a public URL
# that Top.gg can reach.
TOPGG_WEBHOOK_SECRET=

# Studio: Stripe checkout
# The secret key (sk_test_... / sk_live_) and the signing secret from a
# webhook subscription pointed at https://<app>/api/webhooks/stripe.
# Leave all of these empty to keep checkout switched off: the billing page
# then says so plainly and /api/billing/checkout answers 404.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Which provider to use. Only "stripe" exists today; setting anything else
# disables checkout rather than guessing.
PAYMENT_PROVIDER=stripe
# One Stripe price (price_...) per plan. A plan whose price id is empty is
# simply not offered, so checkout can be enabled one plan at a time.
PREMIUM_MONTHLY_PRICE_ID=
PREMIUM_QUARTER_PRICE_ID=
PREMIUM_ANNUAL_PRICE_ID=
# Optional text shown next to each plan. The amount always comes from Stripe,
# so these are display copy only. Defaults: $4.99 / month, $12.99 once,
# $39.99 once.
PREMIUM_MONTHLY_DISPLAY_PRICE=
PREMIUM_QUARTER_DISPLAY_PRICE=
PREMIUM_ANNUAL_DISPLAY_PRICE=

# Application
NODE_ENV=development